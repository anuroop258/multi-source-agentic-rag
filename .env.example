# Required for local UI/API login. Change the password before first use.
APP_USERNAME=admin
APP_PASSWORD=change-this-to-a-long-unique-password

# Required: create a Groq account and API key. The app does not store billing details.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# Search provider: duckduckgo (default, no API key) or tavily (optional API key/free credits).
SEARCH_PROVIDER=duckduckgo
DDGS_REGION=in-en
TAVILY_API_KEY=
TAVILY_ENABLED=false

# Optional Groq server-side browser_search. OFF by default because its billing/availability
# may depend on Groq account/product terms. Do not enable if you require strict zero-cost use.
GROQ_BROWSER_SEARCH_ENABLED=false

# Optional LangSmith tracing. OFF unless explicitly enabled and a key is supplied.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-source-agentic-rag

# Local storage
DATA_DIR=data
CHROMA_DIR=data/chroma
SQLITE_PATH=data/conversations.sqlite3
